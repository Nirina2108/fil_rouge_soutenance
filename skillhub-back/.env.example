# ============================================================
# .env.example — Variables d'environnement Laravel SkillHub
# ============================================================
# Copier en .env puis ajuster pour votre environnement.
# IMPORTANT : ne JAMAIS commit le .env (voir .gitignore).
# Pour SkillHub en Docker, le .env effectif est celui à la
# RACINE du monorepo (pas ce fichier-ci).
# ============================================================

# ─── Application ─────────────────────────────────────────────
# Nom de l'app affiché par les commandes Artisan.
APP_NAME=Laravel
# Environnement : local, testing, staging, production.
APP_ENV=local
# Clé d'app pour le chiffrement Eloquent / sessions / cookies.
# Générer avec : `php artisan key:generate`.
APP_KEY=
# Activer le mode debug (stack trace HTML). Mettre false en prod.
APP_DEBUG=true
APP_URL=http://localhost

# ─── Localisation ────────────────────────────────────────────
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Driver pour le mode "down" (php artisan down).
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Workers PHP CLI server (php artisan serve). Utile en dev seulement.
# PHP_CLI_SERVER_WORKERS=4

# Coût bcrypt pour les mots de passe (12 = prod, 4 = tests rapides).
BCRYPT_ROUNDS=12

# ─── Logs ────────────────────────────────────────────────────
# Channel de logs : stack, single, daily, slack, syslog, etc.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Niveau minimum loggué : debug, info, notice, warning, error, critical, alert, emergency.
LOG_LEVEL=debug

# ─── Base de données principale (MySQL en Docker, SQLite en local) ─
DB_CONNECTION=sqlite
# Décommenter pour MySQL :
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ─── Sessions ────────────────────────────────────────────────
SESSION_DRIVER=database
# Durée de vie d'une session en minutes.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Broadcasting / Filesystem / Queue ───────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Driver de queue : sync, database, redis, sqs.
QUEUE_CONNECTION=database

# ─── Cache ───────────────────────────────────────────────────
# Store du cache : array, database, file, memcached, redis.
CACHE_STORE=database
# CACHE_PREFIX=

# ─── Memcached ───────────────────────────────────────────────
MEMCACHED_HOST=127.0.0.1

# ─── Redis ───────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────
# Driver mail : log (dev), smtp, mailgun, ses, postmark, sendmail.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS S3 (storage cloud, optionnel) ───────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Vite (frontend Laravel pas utilisé sur SkillHub) ────────
# Ces variables s'injectent dans le code frontend via import.meta.env.
VITE_APP_NAME="${APP_NAME}"
