<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuration PHPUnit de SkillHub (Laravel 11).

    Définit :
      - Le bootstrap (autoload Composer).
      - Les deux suites de tests : Unit (isolé) et Feature (HTTP/DB).
      - La cible de couverture : tout le code de app/ (modèles, contrôleurs, services).
      - Les variables d'environnement de test (DB SQLite en mémoire, mail array, etc.).

    Lancement : `php artisan test` ou `vendor/bin/phpunit`.
    Coverage  : `php artisan test` avec les flags coverage et coverage-clover=clover.xml (utilisé par Sonar/CI).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!-- Tests unitaires : pas de bootstrap Laravel, juste PHPUnit pur. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Tests Feature : boot complet de Laravel (DB, services, HTTP). -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!-- Exclusion des tests "heavy" (LoadTest) : trop longs pour le CI rapide.
         Lancement explicite via le flag CLI: phpunit puis le filtre group=heavy.
         Volume paramétrable via env LOAD_TEST_VOLUME (défaut 1000). -->
    <groups>
        <exclude>
            <group>heavy</group>
        </exclude>
    </groups>
    <!-- Périmètre de calcul du coverage : on ne mesure que app/, pas vendor/ ni les configs. -->
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!-- Variables d'environnement injectées pour la durée des tests.
         IMPORTANT : on utilise <server> au lieu de <env> pour DB_*. Sans ca,
         les env Docker (DB_CONNECTION=mysql, DB_DATABASE=skillhub) prennent
         la priorite et RefreshDatabase WIPE la BDD MySQL de prod a chaque
         run de tests. Les <server> ecrasent $_SERVER et getenv(), ce qui
         force Laravel a utiliser sqlite :memory: meme dans Docker. -->
    <php>
        <!-- Mode "testing" : Laravel ajuste son comportement (ex. pas de cache). -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- BCRYPT 4 rounds = très rapide pour les tests (vs 12 en prod). -->
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!-- Cache en RAM : pas de pollution entre tests, pas de besoin de Redis/DB. -->
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- DB SQLite en memoire : reset instantane entre tests via RefreshDatabase.
             <server> + force="true" : ECRASE explicitement DB_CONNECTION=mysql
             injecte par Docker. PROTECTION VITALE de la BDD prod. -->
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_HOST" value="" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_HOST" value="" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- Mail "array" : capture les mails sans les envoyer (assertable via Mail::fake()). -->
        <env name="MAIL_MAILER" value="array" force="true"/>
        <!-- Queue synchrone : les jobs s'executent immediatement, pas de worker requis. -->
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <!-- Desactive les outils tiers (Pulse/Telescope/Nightwatch) pour eviter le bruit pendant les tests. -->
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Volume cible pour les tests heavy (LoadTest).
             Surchargeable au lancement: LOAD_TEST_VOLUME=10000 puis lancer phpunit. -->
        <env name="LOAD_TEST_VOLUME" value="1000"/>
    </php>
</phpunit>
